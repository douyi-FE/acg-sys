# Copy to .env locally. Never commit secrets.
NODE_ENV=development
# Development: the Vite browser and Nest backend use separate ports.
DEV_WEB_PORT=8060
DEV_BACKEND_PORT=8061
# Production: PORT is the Nest backend port; the public proxy port is PROD_PORT.
PROD_PORT=8060
PORT=8060
HOST=127.0.0.1
# MySQL connection used by Prisma. Replace host, port, database, username and password.
DATABASE_URL=mysql://factory:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:3306/content_factory
# Backend runtime names. Keep these secrets server-side; do not expose them as VITE_* variables.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 random bytes encoded as 64 hex characters
AI_SECRET_KEY=
INITIAL_ADMIN_USERNAME=alex
# Required only when creating the administrator for the first time.
# Do not commit this value. The seed command never prints it.
INITIAL_ADMIN_PASSWORD=
CORS_ORIGIN=http://127.0.0.1:8060
COOKIE_SECURE=false
TRUST_PROXY=false
STORAGE_PATH=./storage
# Exact host allowlist. Add trusted LAN IPs explicitly; never use '*'.
ALLOWED_AI_HOSTS=127.0.0.1:8188,localhost:8188,::1:8188,host.docker.internal:8188
COMFYUI_DEFAULT_HOST=127.0.0.1
COMFYUI_DEFAULT_PORT=8188
LLM_DEFAULT_HOST=127.0.0.1
LLM_DEFAULT_PORT=11434
VITE_API_MODE=real
VITE_API_BASE=/api
# Docker database credentials: use different strong values.
MYSQL_DATABASE=content_factory
MYSQL_USER=factory
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
