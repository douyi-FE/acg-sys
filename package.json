{
  "name": "ai-content-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/server"
  ],
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:real": "node scripts/dev.mjs --mode real",
    "dev:demo": "node scripts/dev.mjs --mode demo",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:server": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "server:seed-admin": "pnpm --dir apps/server seed:admin",
    "server:db:generate": "prisma generate",
    "server:db:migrate": "prisma migrate deploy",
    "server:build": "tsc -p apps/server/tsconfig.json",
    "server:typecheck": "tsc -p apps/server/tsconfig.json --noEmit",
    "build:all": "npm run server:db:generate && npm run build && npm run server:build",
    "server:test:typecheck": "tsc -p tsconfig.server-tests.json",
    "typecheck:all": "npm run typecheck && npm run server:typecheck && npm run server:test:typecheck",
    "check:services": "node --env-file-if-exists=.env scripts/check-services.mjs",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:smoke:development": "node scripts/smoke-development.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "docker:up": "docker compose up -d --build"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/client": "^6.19.2",
    "ant-design-vue": "^4.2.6",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "markdown-it": "^15.0.2",
    "pinia": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.24",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.17.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
